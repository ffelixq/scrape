# -----------------------------------------------------------------------------
# Proofline local runtime
# Copy this file to .env and fill in the credentials you want to use.
# The application works in fixture-backed demo mode before keys are added.
# -----------------------------------------------------------------------------
NODE_ENV=development
DEMO_MODE=true
WEB_PORT=5173
API_PORT=4000
AGENT_PORT=8001
VITE_API_URL=http://localhost:4000/api
VITE_SPLINE_SCENE_URL=
CORS_ORIGIN=http://localhost:5173
AGENT_SERVICE_URL=http://localhost:8001
INTERNAL_AGENT_TOKEN=replace-with-a-long-random-string

# PostgreSQL / Prisma
POSTGRES_USER=proofline
POSTGRES_PASSWORD=proofline_local_only
POSTGRES_DB=proofline
DATABASE_URL=postgresql://proofline:proofline_local_only@localhost:5432/proofline?schema=public

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# LLM inference uses automatic failover: Gemini -> Groq -> DeepSeek.
# Configure every key you want available; at least one is required in live mode.
LLM_TEMPERATURE=0.1

# Google Gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Groq (OpenAI-compatible endpoint)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_DAILY_TOKEN_LIMIT=200000
GROQ_DAILY_REQUEST_LIMIT=1000

# DeepSeek (OpenAI-compatible endpoint)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_DAILY_TOKEN_LIMIT=500000

# Durable provider accounting. DeepSeek's limit is enforced before a request is sent.
LLM_MAX_OUTPUT_TOKENS=4096
USAGE_TIMEZONE=Asia/Singapore
USAGE_DB_PATH=.data/provider-usage.sqlite3

# Search providers. The selected provider runs first; configure both keys for automatic failover.
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
SERPER_API_KEY=
SERPER_TOTAL_CREDIT_LIMIT=2500

# Daytona secure research computer
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=us
DAYTONA_SNAPSHOT=
DAYTONA_SANDBOX_TTL_MINUTES=15
DAYTONA_COMMAND_TIMEOUT_SECONDS=120
DAYTONA_DOMAIN_ALLOW_LIST=

# Research and safety policy
MAX_SOURCES_PER_INVESTIGATION=20
MAX_DOWNLOAD_BYTES=25000000
# A DEEP run is search + sandbox retrieval + concurrent supporter/skeptic inference + final audit.
# Keep this aligned with DAYTONA_SANDBOX_TTL_MINUTES so slow provider responses can finish safely.
RESEARCH_TIMEOUT_SECONDS=900
# How long POST /api/investigations waits for Redis to accept the job before running the
# research in-process instead. An unreachable Redis must never hold the request open.
RESEARCH_ENQUEUE_TIMEOUT_MS=5000
# Follow-up questions reuse the stored record and never open a sandbox, so they need far less time.
FOLLOW_UP_TIMEOUT_SECONDS=120
ALLOW_PRIVATE_NETWORKS=false
PROMPT_INJECTION_SENSITIVITY=medium

# Optional observability
SENTRY_DSN=
VITE_SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
