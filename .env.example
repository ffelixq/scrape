# -----------------------------------------------------------------------------
# Proofline local runtime
# Copy this file to .env and fill in the credentials you want to use.
# The application works in fixture-backed demo mode before keys are added.
# -----------------------------------------------------------------------------
NODE_ENV=development
DEMO_MODE=true
WEB_PORT=5173
API_PORT=4000
AGENT_PORT=8001
VITE_API_URL=http://localhost:4000/api
VITE_SPLINE_SCENE_URL=
CORS_ORIGIN=http://localhost:5173
AGENT_SERVICE_URL=http://localhost:8001
INTERNAL_AGENT_TOKEN=replace-with-a-long-random-string

# PostgreSQL / Prisma
POSTGRES_USER=proofline
POSTGRES_PASSWORD=proofline_local_only
POSTGRES_DB=proofline
DATABASE_URL=postgresql://proofline:proofline_local_only@localhost:5432/proofline?schema=public

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# Choose: openai | gemini | kimi | nosana
LLM_PROVIDER=openai
LLM_TEMPERATURE=0.1

# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Google Gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# Moonshot / Kimi (OpenAI-compatible endpoint)
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2.5

# Search providers. Tavily is the default; Serper is the fallback.
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
SERPER_API_KEY=

# Daytona secure research computer
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=us
DAYTONA_SNAPSHOT=
DAYTONA_SANDBOX_TTL_MINUTES=15
DAYTONA_COMMAND_TIMEOUT_SECONDS=120
DAYTONA_DOMAIN_ALLOW_LIST=

# Nosana decentralized GPU inference
# Deploy nosana/proofline-vllm.json, then paste its service URL below.
NOSANA_ENDPOINT_URL=
NOSANA_API_KEY=
NOSANA_MODEL=llama3.1
NOSANA_MARKET=EzuHhkrhmV98HWzREsgLenKj2iHdJgrKmzfL8psP8Aso
NOSANA_NETWORK=mainnet
NOSANA_WALLET_PRIVATE_KEY=

# Research and safety policy
MAX_SOURCES_PER_INVESTIGATION=20
MAX_DOWNLOAD_BYTES=25000000
RESEARCH_TIMEOUT_SECONDS=300
ALLOW_PRIVATE_NETWORKS=false
PROMPT_INJECTION_SENSITIVITY=medium

# Optional observability
SENTRY_DSN=
VITE_SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
